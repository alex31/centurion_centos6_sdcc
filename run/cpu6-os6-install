#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
if [ "$#" -ne 4 ]; then
    printf '%s\n' 'Usage: cpu6-os6-install input.img program.exf NAME output.img' >&2
    exit 2
fi
name=$(printf %s "$3" | LC_ALL=C tr a-z A-Z)
exec python3 "$root/scripts/install-os6-bundle.py" "$1" "$name=$2" -o "$4"

#!/usr/bin/env python3
"""Build a C module for CENTOS 7.13's existing map-6 BASIC monitor loader."""
import argparse
import hashlib
import json
from pathlib import Path
import re
import runpy
import shutil
import subprocess
import sys
import tempfile

ROOT = Path(__file__).resolve().parents[1]
HERE = ROOT / 'os6/mmu'
sys.path.insert(0,str(ROOT/'scripts'))
from cpu6_object import unpack,attach
from cpu6_provenance import compiler_info,input_hashes,write_manifest


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('sources', nargs='+', type=Path)
    parser.add_argument('-o', required=True, type=Path)
    parser.add_argument('--name', required=True)
    parser.add_argument('--module-id', required=True, type=lambda s: int(s, 0))
    parser.add_argument('--max-bytes', type=int, default=20480)
    parser.add_argument('--float32', action='store_true')
    parser.add_argument('-I', action='append', default=[])
    parser.add_argument('-D', action='append', default=[])
    parser.add_argument('--save-temps', type=Path)
    parser.add_argument('-O',choices=['0','1','s'],default='1')
    parser.add_argument('--no-lto',action='store_true')
    args = parser.parse_args()
    if not re.fullmatch('[A-Z][A-Z0-9]{0,9}', args.name):
        parser.error('--name must contain 1-10 uppercase letters/digits, starting with a letter')
    if not 1 <= args.module_id <= 65535:
        parser.error('--module-id must be between 1 and 65535')
    if not 1 <= args.max_bytes <= 20480:
        parser.error('--max-bytes must be between 1 and the validated 20480-byte page budget')
    sources = [p.resolve(strict=True) for p in args.sources]
    if any(p.suffix not in ['.c', '.s'] for p in sources):
        parser.error('inputs must be C or assembly sources')
    output = args.o.resolve()
    if output.suffix != '.exf':
        parser.error('-o must name an .exf file; .json/.h/.map siblings are generated')
    outputs = [output.with_suffix(s) for s in ['.exf', '.json', '.h', '.map']]
    if any(p in sources for p in outputs):
        parser.error('outputs must not overwrite an input')
    flags = ['-O'+args.O, '-I' + str(HERE),
             '-DOS6_MMU_MODULE_ID=' + str(args.module_id)]
    if args.float32:
        flags += ['--float32']
    flags += ['-I' + str(Path(p).resolve()) for p in args.I] + ['-D' + p for p in args.D]
    with tempfile.TemporaryDirectory(prefix='cpu6-mmu-') as directory:
        work = Path(directory)
        try:
            objects = []
            for i, source in enumerate([HERE / 'start.s', HERE / 'entry.c', *sources]):
                unit = source
                if source.suffix == '.c':
                    unit = work / ('unit%d.c' % i)
                    unit.write_text('#include "os6mmu.h"\n#include ' + json.dumps(str(source)) + '\n')
                obj = work / ('unit%d.o' % i)
                subprocess.run([ROOT / 'run/cpu6-os6-sdcc', '-c', *flags,
                                '-I' + str(source.parent), unit, '-o', obj], check=True)
                objects.append(obj)
            if not args.no_lto:
                assemblies=[]
                for obj in objects:
                    raw,ir=unpack(obj.read_bytes())
                    if ir is None:raise ValueError('fresh module object lacks LTO IR')
                    asm=obj.with_suffix('.s');asm.write_text(ir['assembly']);assemblies.append(asm)
                runpy.run_path(str(ROOT/'scripts/cpu6_lto.py'))['optimize'](assemblies,work/'lto-report.json')
                for obj,asm in zip(objects,assemblies):
                    subprocess.run([ROOT/'build/out/toolchain/bin/asee200','-o',obj,asm],check=True);attach(obj,asm.read_text())
            libraries = []
            if args.float32:
                libraries.append(ROOT / 'build/out/toolchain/lib/cpu6/libfloat32-sdcc.a')
            libraries.append(ROOT / 'build/out/toolchain/lib/cpu6/libcompiler-sdcc.a')
            binary, mapping, reloc = [work / ('module' + s) for s in ['.bin', '.map', '.rel']]
            subprocess.run([ROOT / 'run/cpu6-ld', '--gc-sections', '--entry=__mmu_start',
                            '--gc-report', work / 'gc-report.json', '-b', '-C', '0',
                            '-R', reloc, '-m', mapping, '-o', binary, *objects, *libraries], check=True)
            symbols = {f[2]: int(f[0], 16) for line in mapping.read_text().splitlines()
                       if len(f := line.split()) == 3}
            size = symbols['__end']
            if symbols['__mmu_start'] != 0 or not 0 < size <= args.max_bytes:
                raise ValueError('module needs %d bytes (budget %d), or entry is not at zero' % (size, args.max_bytes))
            if any(symbols.get('__' + s + '_size', 0) for s in
                   ['common', 'commondata', 'zp', 'discard', 'buffers']):
                raise ValueError('MMU modules must use ordinary code/data/BSS sections')
            raw = binary.read_bytes()
            if len(raw) > size:
                raise ValueError('binary extends past module end')
            # A single startup image contains all C static initialization.
            # No CRT is run on individual calls and BSS persists until reboot.
            raw += bytes(size - len(raw))
            records = reloc.read_bytes()
            if len(records) % 3 or any(records[i] != 1 for i in range(0, len(records), 3)):
                raise ValueError('unsupported module relocation')
            fixups = [int.from_bytes(records[i+1:i+3], 'big') for i in range(0, len(records), 3)]
            pack = runpy.run_path(str(ROOT / 'run/mkos6bin.py'))['make_cbin_sections']
            cbin = pack([(0, raw)], 0, fixups)
            descriptor = {'format': 'cpu6-centos-mmu-monitor', 'abi': 1,
                          'name': args.name, 'moduleId': args.module_id,
                          'bytes': size, 'pages': (size + 2047) // 2048,
                          'logicalStart': 0x1000, 'logicalEnd': 0x1000 + size,
                          'code': symbols['__code_size'], 'data': symbols['__data_size'],
                          'bss': symbols['__bss_size'], 'float32': args.float32,
                          'launch': '.LOAD BASIC ' + args.name,
                          'sha256': hashlib.sha256(cbin).hexdigest(),
                          'sources': {str(p): hashlib.sha256(p.read_bytes()).hexdigest() for p in sources}}
            macro = args.name + '_MMU'
            header = '#ifndef ' + macro + '_H\n#define ' + macro + '_H\n#include "os6mmu.h"\n'
            header += '#define ' + macro + '_ID ' + str(args.module_id) + 'U\n'
            header += '#define ' + macro + '_BYTES ' + str(size) + 'U\n#endif\n'
            output.write_bytes(cbin)
            provenance=write_manifest(output,compiler_info(ROOT/'build/out/toolchain/sdcc-cpu6/bin/sdcc'),flags,
                                     input_hashes([*sources,HERE/'entry.c',HERE/'start.s',*libraries]),profile='O'+args.O,lto=not args.no_lto,gc=True)
            descriptor.update(compiler=provenance['compiler'],profile='O'+args.O,lto=not args.no_lto,gc=True)
            output.with_suffix('.json').write_text(json.dumps(descriptor, indent=2) + '\n')
            output.with_suffix('.h').write_text(header)
            shutil.copyfile(mapping, output.with_suffix('.map'))
            print('%s: %d bytes, %d MMU pages, ABI 1' % (args.name, size, descriptor['pages']))
        finally:
            if args.save_temps:
                args.save_temps.mkdir(parents=True, exist_ok=True)
                for p in work.iterdir():
                    if p.is_file():
                        shutil.copyfile(p, args.save_temps / p.name)


if __name__ == '__main__':
    try:
        main()
    except (OSError, RuntimeError, ValueError, subprocess.CalledProcessError) as error:
        print('cpu6-mmu:', error, file=sys.stderr)
        sys.exit(1)

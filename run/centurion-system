#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
server="$root/build/out/emulator/server/src/server.js"
case "${1-}" in
    -h|--help)
        printf '%s\n' 'Usage: centurion-system [disk-image]' \
            'Web console at http://127.0.0.1:42646/' \
            'Telnet CRT0 is available at 127.0.0.1:2324.' \
            'CENTURION_EMULATOR=auto|cpp|javascript selects the backend.'
        exit 0
        ;;
esac
case "${CENTURION_EMULATOR:-auto}" in
    cpp) exec "$root/run/centurion-system-cpp" "$@" ;;
    auto)
        if [ -x "$root/build/out/emulator-cpp/centurion-emulator" ]; then
            exec "$root/run/centurion-system-cpp" "$@"
        fi
        ;;
    javascript) ;;
    *)
        printf '%s\n' 'CENTURION_EMULATOR must be auto, cpp or javascript.' >&2
        exit 2
        ;;
esac
if [ "$#" -gt 1 ]; then
    printf '%s\n' 'Usage: centurion-system [disk-image]' >&2
    exit 2
fi
if [ ! -f "$server" ]; then
    printf '%s\n' 'Build the native emulator with make emulator-cpp or the JavaScript reference with make emulator.' >&2
    exit 1
fi
if [ "$#" -eq 1 ]; then
    export CENTURION_DISK_IMAGE="$1"
elif [ -z "${CENTURION_DISK_IMAGE-}" ] && [ -r "$root/build/out/image/centos-apps.img" ]; then
    export CENTURION_DISK_IMAGE="$root/build/out/image/centos-apps.img"
fi
if [ -n "${CENTURION_DISK_IMAGE-}" ] && [ ! -r "$CENTURION_DISK_IMAGE" ]; then
    printf 'Disk image is unreadable: %s\n' "$CENTURION_DISK_IMAGE" >&2
    exit 1
fi
exec node "$server"

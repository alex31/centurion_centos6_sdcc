10 REM JON MILLEN 1D LIFE - B23/S24, FOUR NEIGHBOURS
11 REM BUFFER EACH ROW IN L$ TO REDUCE BASIC PRINT OVERHEAD
12 DEFINT A-Z
14 DIM X(68),Y(68)
20 M=68
30 G=26
40 S=1
100 FOR I=2 TO M-2
110 S=(17*S+43) MOD 256
130 IF S<128 THEN X(I)=1
140 NEXT I
150 PRINT "1D LIFE - B23/S24"
160 GOSUB 700
170 FOR T=1 TO G
180 FOR I=2 TO M-2
190 C=X(I-2)+X(I-1)+X(I+1)+X(I+2)
250 Y(I)=0
260 IF X(I)=0 THEN 310
270 IF C=2 THEN 350
280 IF C=4 THEN 350
290 GOTO 360
310 IF C=2 THEN 350
320 IF C=3 THEN 350
330 GOTO 360
350 Y(I)=1
360 NEXT I
370 FOR I=0 TO M
380 X(I)=Y(I)
390 NEXT I
400 GOSUB 700
410 NEXT T
420 PRINT "DONE"
430 END
700 L$="|"
710 FOR I=0 TO M
720 IF X(I)=1 THEN 750
730 L$=L$+" "
740 GOTO 760
750 L$=L$+"*"
760 NEXT I
765 L$=L$+"|"
770 PRINT L$
780 RETURN
